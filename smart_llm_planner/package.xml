<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smart_llm_planner</name>
  <version>0.1.0</version>
  <description>SMART-LLM (Kannan et al., IROS 2024) ported to ROS 2: task decomposition, coalition formation and task allocation with an LLM, re-run on every world-state change.</description>
  <maintainer email="todo@example.com">Andrea Basuroski</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
