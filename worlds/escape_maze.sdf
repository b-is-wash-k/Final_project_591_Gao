<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Two-room escape maze: walls, one lift gate (D1), red and blue switch pads, start markers, exit.
       Gate D1 is commanded on the Gazebo topic /maze/door/D1/position (0.0 = closed, 1.3 = open). -->
  <world name="escape_maze">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors and IMU systems, so spawned robots publish LiDAR and IMU data. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <!-- Floor -->
    <model name="maze_floor">
      <static>true</static>
      <pose>0 0 -0.06 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>12.4 5.6 0.12</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>12.4 5.6 0.12</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.72 1</ambient>
            <diffuse>0.68 0.70 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary: 12 m by 5 m interior, 1.2 m high walls. -->
    <model name="wall_north">
      <static>true</static><pose>0 2.6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 0.2 1.2</size></box></geometry><material><ambient>0.32 0.36 0.40 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -2.6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 0.2 1.2</size></box></geometry><material><ambient>0.32 0.36 0.40 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-6.1 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 5.2 1.2</size></box></geometry><material><ambient>0.32 0.36 0.40 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>6.1 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 5.2 1.2</size></box></geometry><material><ambient>0.32 0.36 0.40 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Room divider with a 1.6 m doorway opening centered at y=0. -->
    <model name="divider_south">
      <static>true</static><pose>0 -1.65 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 1.7 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 1.7 1.2</size></box></geometry><material><ambient>0.40 0.44 0.48 1</ambient><diffuse>0.40 0.44 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="divider_north">
      <static>true</static><pose>0 1.65 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 1.7 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 1.7 1.2</size></box></geometry><material><ambient>0.40 0.44 0.48 1</ambient><diffuse>0.40 0.44 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Lift gate: joint position 0 m is closed; 1.3 m lifts it clear. -->
    <model name="door_D1">
      <link name="panel">
        <gravity>false</gravity>  <!-- so the position controller reaches the commanded height -->
        <pose>0 0 0.6 0 0 0</pose>
        <inertial>
          <mass>10</mass>
          <inertia><ixx>3.075</ixx><iyy>1.221</iyy><izz>1.900</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="panel_collision">
          <geometry><box><size>0.16 1.5 1.2</size></box></geometry>
        </collision>
        <visual name="panel_visual">
          <geometry><box><size>0.16 1.5 1.2</size></box></geometry>
          <material>
            <ambient>0.75 0.58 0.18 1</ambient>
            <diffuse>0.85 0.66 0.20 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="D1_lift" type="prismatic">
        <parent>world</parent>
        <child>panel</child>
        <pose>0 0 0.6 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0</lower><upper>1.3</upper><effort>200</effort><velocity>1.0</velocity></limit>
          <dynamics><damping>20</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>D1_lift</joint_name>
        <topic>/maze/door/D1/position</topic>
        <p_gain>100</p_gain>
        <i_gain>0</i_gain>
        <d_gain>10</d_gain>
        <cmd_min>-200</cmd_min>
        <cmd_max>200</cmd_max>
      </plugin>
    </model>

    <!-- Visual-only markers (no collision). Switch occupancy is detected by scripts/switch_manager.py. -->
    <model name="start_red">
      <static>true</static><pose>-4.8 -0.65 0.01 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.32</radius><length>0.02</length></cylinder></geometry><material><ambient>0.85 0.12 0.12 1</ambient><diffuse>0.95 0.16 0.16 1</diffuse></material></visual></link>
    </model>
    <model name="start_blue">
      <static>true</static><pose>-4.8 0.65 0.01 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.32</radius><length>0.02</length></cylinder></geometry><material><ambient>0.10 0.22 0.85 1</ambient><diffuse>0.16 0.32 0.98 1</diffuse></material></visual></link>
    </model>
    <model name="switch_S_R">
      <static>true</static><pose>-1.1 -1.45 0.02 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.30</radius><length>0.04</length></cylinder></geometry><material><ambient>0.75 0.06 0.06 1</ambient><diffuse>0.95 0.10 0.10 1</diffuse></material></visual></link>
    </model>
    <model name="switch_S_B">
      <static>true</static><pose>1.1 1.45 0.02 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.30</radius><length>0.04</length></cylinder></geometry><material><ambient>0.06 0.15 0.75 1</ambient><diffuse>0.10 0.25 0.95 1</diffuse></material></visual></link>
    </model>
    <model name="exit_marker">
      <static>true</static><pose>5.1 0 0.02 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.45</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.65 0.18 1</ambient><diffuse>0.10 0.85 0.22 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
